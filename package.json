{
  "name": "portfolio-constellation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node --experimental-strip-types scripts/generate.ts",
    "dev": "npm run generate && vite --host 127.0.0.1 --port 5318 --strictPort",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/content.test.ts tests/state.test.ts tests/camera.test.ts tests/audio.test.ts",
    "build": "npm run generate && tsc --noEmit && vite build && node scripts/artifact.mjs",
    "preview": "node scripts/serve.mjs",
    "test:browser": "playwright test",
    "capture": "node scripts/capture.mjs",
    "check:artifact": "node scripts/check-artifact.mjs",
    "check:links": "node --experimental-strip-types scripts/check-links.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
